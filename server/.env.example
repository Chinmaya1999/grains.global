PORT=5050
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=

# Security
# Comma-separated site origins allowed to call the API with cookies (defaults to the Vite dev server).
CLIENT_ORIGIN=
# Set to 1 when running behind nginx or a load balancer so rate limits see the real client IP.
TRUST_PROXY=
# Set to production on the live server (enables Secure cookies and HSTS).
NODE_ENV=
